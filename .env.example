# ---------------------------------------------------------------------------------------------
# Mobile OTP debug (DEV / TEST ONLY — never set these in a production .env)
#
# MOBILE_OTP_DEBUG=true  the mobile OTP endpoint returns `debugCode` in its JSON response so the
#                        driver/farmer login can be tested without an SMS gateway.
# NIR_ENV=dev            second, independent marker. The dev VPS runs NODE_ENV=production, so the
#                        debug code is refused unless the deployment declares itself as dev
#                        (server/services/mobileOtpDebug.ts). A prod .env must carry neither key.
#
# Applied on the dev VPS with:  .\psremoting\dev-enable-mobile-otp-debug.ps1
# ---------------------------------------------------------------------------------------------
# MOBILE_OTP_DEBUG=true
# NIR_ENV=dev

# ==========================================
# NIR Industrial Management System Configuration
# ==========================================

# Application Environment (development | production)
NODE_ENV=production

# Server Network Configuration
# Production MUST stay loopback-only; nginx is the only public entry point.
PORT=3000
HOST=127.0.0.1

# Authoritative PostgreSQL Database URL
DATABASE_URL=postgresql://nir_user:CHANGE_ME@127.0.0.1:5432/nir_db

# Path to PostgreSQL client tools (pg_dump/pg_restore) if not on PATH
PG_BIN=

# JSON Web Token secret (minimum 32 random characters). REQUIRED in production.
JWT_SECRET=

# Public API base URL for the frontend build (leave empty for same-origin)
VITE_API_BASE_URL=
API_BASE_URL=

# Cross-Origin Resource Sharing (comma-separated origins, or * for open LAN)
CORS_ORIGIN=
ALLOWED_ORIGINS=

# Cookie policy: set to 1 when served through a reverse proxy over HTTPS
CROSS_SITE_COOKIE=0

# Local file storage
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
# Explicit frontend build directory (defaults to ./dist)
NIR_DIST_PATH=

# Google Gemini API key for automated invoice/remittance extraction (optional)
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# DEVELOPMENT-ONLY SWITCHES — NEVER enable these in production.
# Both are additionally hard-guarded by NODE_ENV !== "production" in code and
# are ignored (never applied) when NODE_ENV=production.
# ---------------------------------------------------------------------------
# AI Studio preview: bypasses session auth for the AI Studio dev environment.
AI_STUDIO_PREVIEW=false
# In-process PGlite test database (development/testing only).
PGLITE_TEST=false

# Database pool tuning (optional)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# باسکول (Weighbridge) — سینک قبوض از SQL Server کارخانه
# WEIGHBRIDGE_PASS may be a read-only SQL login; never commit a real value.
# ---------------------------------------------------------------------------
WEIGHBRIDGE_HOST=
WEIGHBRIDGE_PORT=1433
WEIGHBRIDGE_DB=WEIGHNGDB
WEIGHBRIDGE_USER=
WEIGHBRIDGE_PASS=
WEIGHBRIDGE_TABLE=WeightTable
WEIGHBRIDGE_SCHEMA=dbo
WEIGHBRIDGE_BATCH=5000
WEIGHBRIDGE_LOOKBACK_HOURS=8760
# Optional explicit column map (JSON) — pins the vendor column names so fuzzy
# discovery can never pick the wrong one. Omit to let the worker auto-discover.
# WEIGHBRIDGE_COLUMN_MAP={"externalId":"ID","ticketNumber":"ShomareHavale","plateNumber":"TruckNo","driverName":"DriverName","customerName":"CustomerName","goods":"Goods","grossWeight":"WeightFull","tareWeight":"WeightEmpty","netWeight":"NetWeight","weighTime":"DateFull","direction":"InOutFlag","remittanceNumber":"ShomareHavale"}
WEIGHBRIDGE_LOG_DIR=
WEIGHBRIDGE_WORKER=
